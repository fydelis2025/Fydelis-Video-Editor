<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="FydelisAiPanel" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="spacing">8</property>
    <property name="margin">8</property>
    
    <child>
      <object class="GtkLabel" id="status">
        <property name="label">Pronto</property>
        <property name="xalign">0</property>
        <property name="wrap">True</property>
      </object>
    </child>
    
    <child>
      <object class="GtkProgressBar" id="progress">
        <property name="visible">False</property>
      </object>
    </child>
    
    <child>
      <object class="GtkButton" id="btn_transcribe">
        <property name="label">📝 Legendas Automáticas</property>
        <property name="css-classes">fydelis-btn</property>
      </object>
    </child>
    
    <child>
      <object class="GtkButton" id="btn_denoise">
        <property name="label">🔊 Limpar Áudio</property>
        <property name="css-classes">fydelis-btn</property>
      </object>
    </child>
    
    <child>
      <object class="GtkButton" id="btn_track">
        <property name="label">🎯 Rastrear Objeto</property>
        <property name="css-classes">fydelis-btn</property>
      </object>
    </child>
    
    <child>
      <object class="GtkButton" id="btn_upscale">
        <property name="label">⬆️ Melhorar Resolução</property>
        <property name="css-classes">fydelis-btn</property>
      </object>
    </child>
    
    <child>
      <object class="GtkButton" id="bg_remove">
        <property name="label">🗑️ Remover Fundo</property>
        <property name="css-classes">fydelis-btn</property>
      </object>
    </child>
    
    <child>
      <object class="GtkButton" id="btn_tts">
        <property name="label">🗣️ Narração por Voz</property>
        <property name="css-classes">fydelis-btn</property>
      </object>
    </child>
  </template>
</interface>