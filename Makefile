####### Compile

main.o: src/main.c include/fydelis-editor.h \
		include/ui/main-window.h \
		include/core/timeline.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o main.o src/main.c

timeline.o: src/core/timeline.c include/core/timeline.h \
		include/fydelis-editor.h \
		include/core/clip.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o timeline.o src/core/timeline.c

clip.o: src/core/clip.c include/core/clip.h \
		include/fydelis-editor.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o clip.o src/core/clip.c

exporter.o: src/core/exporter.c include/core/exporter.h \
		include/fydelis-editor.h \
		include/core/timeline.h \
		include/core/ffmpeg-utils.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o exporter.o src/core/exporter.c

renderer.o: src/core/renderer.c include/core/renderer.h \
		include/fydelis-editor.h \
		include/core/timeline.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o renderer.o src/core/renderer.c

ffmpeg-utils.o: src/core/ffmpeg-utils.c include/core/ffmpeg-utils.h \
		include/fydelis-editor.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o ffmpeg-utils.o src/core/ffmpeg-utils.c

main-window.o: src/ui/main-window.c include/ui/main-window.h \
		include/core/timeline.h \
		include/fydelis-editor.h \
		include/ui/timeline-view.h \
		include/ui/ai-panel.h \
		include/ui/media-library.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o main-window.o src/ui/main-window.c

timeline-view.o: src/ui/timeline-view.c include/ui/timeline-view.h \
		include/core/timeline.h \
		include/fydelis-editor.h \
		include/core/clip.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o timeline-view.o src/ui/timeline-view.c

ai-panel.o: src/ui/ai-panel.c include/ui/ai-panel.h \
		include/ai/whisper-bridge.h \
		include/fydelis-editor.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o ai-panel.o src/ui/ai-panel.c

media-library.o: src/ui/media-library.c include/ui/media-library.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o media-library.o src/ui/media-library.c

export-dialog.o: src/ui/export-dialog.c include/ui/export-dialog.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o export-dialog.o src/ui/export-dialog.c

whisper-bridge.o: src/ai/whisper-bridge.c include/ai/whisper-bridge.h \
		include/fydelis-editor.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o whisper-bridge.o src/ai/whisper-bridge.c

denoise.o: src/ai/denoise.c include/ai/denoise.h \
		include/fydelis-editor.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o denoise.o src/ai/denoise.c

moc_export-dialog.o: moc_export-dialog.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_export-dialog.o moc_export-dialog.cpp

